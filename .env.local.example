# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — it never gets committed.

# Resend (https://resend.com) sends all admin notification emails —
# contact form, waitlist signups, and 8-week applications.
#
# How to set up:
#   1. Sign up at https://resend.com using katrinagcoaching@gmail.com
#      (this makes the free sandbox sender able to deliver to that inbox
#      without verifying a custom domain — see note below).
#   2. Go to https://resend.com/api-keys and create a new API key.
#   3. Paste it here.
RESEND_API_KEY=

# Optional — the "from" address emails are sent as. Defaults to Resend's
# shared sandbox sender if left unset. The sandbox sender
# (onboarding@resend.dev) can only deliver to the email address that owns
# the Resend account above — fine for launch since that's
# katrinagcoaching@gmail.com anyway. To send from a real address like
# hello@trine.com instead, verify a domain at
# https://resend.com/domains and set this to an address on it, e.g.
# RESEND_FROM_EMAIL=Trine Website <hello@trine.com>
# RESEND_FROM_EMAIL=Trine Website <onboarding@resend.dev>

# Optional — where the admin notification emails land. Defaults to
# katrinagcoaching@gmail.com in code if left unset, so this line is only
# needed if you want notifications to go somewhere else.
# ADMIN_EMAIL=katrinagcoaching@gmail.com
